{
  "manifest_version": 3,
  "name": "KIO Browser Connector",
  "version": "0.1.0",
  "description": "Allows KIO to manage browser tabs from the desktop assistant.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "ws://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon48.png"
  }
}
