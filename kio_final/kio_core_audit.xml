class KnowledgeFallback:
    """Bounded deterministic educational fallback responses.

    Not retrieval, not RAG — purely hardcoded.
    Used when provider unavailable or semantic quality rejected.
    """

    _BOOTSTRAP_TOPICS = {
        "python", "javascript", "java", "c", "kio", "malayalam", 
        "python_syntax", "js_syntax", "recursion", "ai", "ml", "os", 
        "rocket_science", "video_editing"
    }

    def __init__(self):
        self._lesson_progress: dict[str, int] = {}
        self.current_topic: Optional[str] = None
        self.current_learning_topic: Optional[str] = None
        self.current_learning_mode: bool = False

    def is_bootstrap_topic(self, text: str) -> bool:
        """Return True if the topic is part of the local bootstrap lesson pack."""
        topic = self.detect_topic(text)
        return topic in self._BOOTSTRAP_TOPICS

    def detect_topic(self, user_text: str) -> Optional[str]:
        lower = user_text.lower().strip().strip(".,!?;:")
        if not lower:
            return None
        
        # Check longer phrases first to avoid partial matching (e.g. "python syntax" vs "python")
        sorted_keys = sorted(_TOPIC_ALIASES.keys(), key=len, reverse=True)
        for alias in sorted_keys:
            pattern = r'\b' + re.escape(alias) + r'\b'
            if re.search(pattern, lower):
                return _TOPIC_ALIASES[alias]
        
        words = lower.split()
        for word in words:
            clean = word.strip(".,!?;:'\"")
            if clean in _TOPIC_ALIASES:
                return _TOPIC_ALIASES[clean]
        return None

    def get_fallback(self, user_text: str) -> Optional[str]:
        topic = self.detect_topic(user_text)
        if topic:
            self.current_topic = topic
            self.current_learning_topic = topic
            self.current_learning_mode = True
            self._lesson_progress[topic] = 0
            
            lesson = _LESSONS.get(topic)
            if lesson:
                logger.debug(f"knowledge_fallback: used for topic '{topic}'")
                reply = lesson[0]
                if len(lesson) > 1:
                    reply += " Say 'next' for more."
                return reply
            
            response = _KNOWLEDGE_FALLBACKS.get(topic)
            if response:
                logger.debug(f"knowledge_fallback: used for topic '{topic}'")
                return response
        return None

    def get_continuation(self, user_text: str) -> Optional[str]:
        if self.is_continuation_request(user_text):
            topic = self.current_learning_topic
            if not topic:
                topic = self._detect_active_lesson()
            if topic:
                part = self._lesson_progress.get(topic, 1)
                lesson = _LESSONS.get(topic)
                if lesson:
                    if part < len(lesson):
                        self._lesson_progress[topic] = part + 1
                        logger.debug(f"knowledge_fallback: continuing {topic} lesson part {part + 1}")
                        reply = lesson[part]
                        if part + 1 < len(lesson):
                            reply += " Say 'next' for more."
                        return reply
                    else:
                        self.current_learning_mode = False
                        self.current_learning_topic = None
                        return f"That's all the {topic.replace('_', ' ')} basics I have! Try practicing."
        return None

    def is_educational_request(self, user_text: str) -> bool:
        lower = user_text.lower().strip()
        triggers = [
            "teach me", "explain", "basics", "syntax", "coding",
            "tutorial", "beginner guide", "learn"
        ]
        if any(t in lower for t in triggers):
            return True
        if "how does" in lower and "work" in lower:
            return True
        return bool(_EDUCATIONAL_TRIGGERS.search(user_text))

    def is_continuation_request(self, user_text: str) -> bool:
        return bool(_CONTINUATION_TRIGGERS.match(user_text.strip()))

    def get_lesson_at_step(self, topic: str, step: int) -> Optional[str]:
        """Get lesson at specific step WITHOUT resetting progress.

        step is 0-indexed (internal storage convention).
        Runtime owns continuity state — this reads only.
        Does NOT call detect_topic() or reset _lesson_progress.
        Used by continuity intercept for deterministic step-based progression.
        """
        canonical = _TOPIC_ALIASES.get(topic.lower(), topic.lower())
        lessons = _LESSONS.get(canonical)
        if lessons and 0 <= step < len(lessons):
            reply = lessons[step]
            self._lesson_progress[canonical] = step
            self.current_learning_topic = canonical
            self.current_learning_mode = True
            if isinstance(reply, str) and step < len(lessons) - 1:
                reply += " Say 'next' for more."
            return reply
        return None

    def clear_lesson(self, topic: str = "malayalam") -> None:
        self._lesson_progress.pop(topic, None)
        if self.current_learning_topic == topic:
            self.current_learning_topic = None
            self.current_learning_mode = False

    def _detect_active_lesson(self) -> Optional[str]:
        if self.current_learning_mode and self.current_learning_topic:
            return self.current_learning_topic
        for topic in self._lesson_progress:
            return topic
        return None
